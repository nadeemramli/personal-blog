filters:
  and:
    - 'type == "product"'
    - 'stack == "Protein & Pre-Intra"'
views:
  - type: table
    name: Protein & Pre-Intra
    order:
      - file.name
      - brand
      - status
      - current_phase
      - stock_on_hand
      - daily_dose
      - restock
      - importance
      - cost_per_bottle
