filters:
  and:
    - 'type == "product"'
    - 'stack == "Ancillaries & Cycle Support"'
views:
  - type: table
    name: Ancillaries & Cycle Support
    order:
      - file.name
      - brand
      - status
      - current_phase
      - stock_on_hand
      - daily_dose
      - restock
      - importance
      - cost_per_bottle
