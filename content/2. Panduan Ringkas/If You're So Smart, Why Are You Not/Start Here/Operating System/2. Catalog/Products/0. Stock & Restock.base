filters:
  and:
    - type == "product"
    - status != "planned"
views:
  - type: table
    name: To buy
    filters:
      and:
        - restock != "OK"
        - restock != "Not needed now"
        - restock != "— (INDEXA)"
    order:
      - file.name
      - stack
      - restock
      - stock_on_hand
      - current_phase
      - importance
  - type: table
    name: Needs restock
    filters:
      and:
        - status == "restock"
    order:
      - file.name
      - stack
      - re