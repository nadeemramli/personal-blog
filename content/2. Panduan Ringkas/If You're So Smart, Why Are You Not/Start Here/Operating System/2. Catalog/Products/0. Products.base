filters:
  and:
    - type == "product"
formulas:
  cost_per_dose: cost_per_bottle / package_size
  dose_per_half_serving: base_dose / 2
properties:
  note.brand:
    displayName: Brand
  note.cost_per_bottle:
    displayName: Cost / bottle (RM)
  formula.cost_per_dose:
    displayName: Cost / dose (RM)
  formula.dose_per_half_serving:
    displayName: Half serving
views:
  - type: table
    name: Catalog
    order:
      - file.name
      - brand
      - vendor
      - list_price
      - promo_price
      - cost_per_bottle
      - formula.cost_per_dose
      - base_dose
      - formula.dose_per_half_serving
      - dose_unit
