filters:
  and:
    - type == "overhead"
formulas:
  annualised: eff_monthly * 12
views:
  - type: table
    name: Cost ledger
    order:
      - file.name
      - pillar
      - category
      - cost
      - billing
      - eff_monthly
      - formula.annualised
      - status
  - type: table
    name: By pillar
    order:
      - pillar
      - category
      - file.name
      - eff_monthly
